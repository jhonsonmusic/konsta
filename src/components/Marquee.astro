---
import { idiomaDeUrl, t } from '../i18n/ui';

const text = t(idiomaDeUrl(Astro.url)).hero.marquee;
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    <span>{text}</span>
    <span>{text}</span>
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    /* Mismo aire arriba que abajo. */
    padding-block: clamp(26px, 4vh, 46px);
    white-space: nowrap;
  }

  .marquee__track {
    display: inline-flex;
    gap: 40px;
    animation: km-marquee 26s linear infinite;
    font-family: var(--font-display);
    font-size: clamp(40px, 5.2vw, 88px);
    letter-spacing: 0.06em;
    color: transparent;
    -webkit-text-stroke: 1px var(--marquee-stroke);
  }
</style>
