---
import SocialLinks from './SocialLinks.astro';
import { idiomaDeUrl, ruta, t } from '../i18n/ui';

const idioma = idiomaDeUrl(Astro.url);
const txt = t(idioma);
const actual = Astro.url.pathname.replace(/\/$/, '') || '/';

const enlaces = [
  { href: ruta(idioma, '/'), label: txt.nav.inicio },
  { href: ruta(idioma, '/origen'), label: txt.nav.origen },
  { href: ruta(idioma, '/modo-tiburon'), label: txt.nav.tiburon },
  { href: ruta(idioma, '/ecosistema'), label: txt.nav.ecosistema },
  { href: ruta(idioma, '/coleccion-legado'), label: txt.nav.legado },
  { href: ruta(idioma, '/vision-2029'), label: txt.nav.vision },
  { href: ruta(idioma, '/ser-aliado'), label: txt.nav.aliado },
];

const esActual = (href: string) => actual === href.replace(/\/$/, '');
---

<footer class="footer">
  <div class="footer__top">
    <a href={ruta(idioma, '/')} class="footer__logo" aria-label={txt.nav.inicioAria}>
      <img src="/assets/konsta-logo.png" alt="Konsta" width="85" height="40" />
    </a>

    <nav class="footer__nav" aria-label={txt.nav.secundaria}>
      {
        enlaces.map((l) => (
          <a href={l.href} aria-current={esActual(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="footer__legal">
    <div class="footer__redes">
      <span>{txt.comun.siguenos}</span>
      <SocialLinks size={20} gap={18} />
    </div>

    <span class="footer__credito">
      © 2026 · {txt.comun.credito}
      <a href="https://conex1onpsh.com" target="_blank" rel="noopener">Conex1on PSH</a>
    </span>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(48px, 8vh, 96px);
    padding-top: 28px;
    border-top: 1px solid var(--hairline);
  }

  .footer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: clamp(20px, 3vw, 40px);
    padding-inline: var(--gutter);
  }

  .footer__credito a {
    color: inherit;
    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    transition: opacity 0.25s var(--ease-out);
  }

  .footer__credito a:hover {
    color: inherit;
    opacity: 0.75;
  }

  .footer__logo img {
    height: 40px;
    width: auto;
    display: block;
  }

  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(12px, 1.5vw, 22px);
    font-size: clamp(13px, 1.05vw, 15px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .footer__nav a[aria-current='page'] {
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
  }

  /* Banda azul de cierre, a todo el ancho y con el contenido centrado. */
  .footer__legal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin-top: clamp(28px, 4vh, 44px);
    padding: clamp(30px, 5vh, 46px) var(--gutter) clamp(38px, 6vh, 56px);
    background: var(--color-blue);
    color: var(--color-white);
    text-align: center;
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .footer__redes {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
    color: var(--color-white);
  }

  /* En móvil los botones flotantes ocupan la esquina inferior derecha:
     el crédito necesita altura extra para no quedar debajo. */
  @media (max-width: 760px) {
    .footer__legal {
      padding-bottom: 150px;
    }
  }
</style>
