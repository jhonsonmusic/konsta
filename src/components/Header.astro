---
import SocialLinks from './SocialLinks.astro';

const navLinks = [
  { href: '#tiburon', label: 'Modo Tiburón' },
  { href: '#origen', label: 'Historia' },
  { href: '#legado', label: 'Colección Legado' },
  { href: '#vision', label: 'Visión 2029' },
];
---

<header class="header">
  <a href="#hero" class="header__logo" aria-label="Konsta — inicio">
    <!-- 1004×472 en origen: la proporción debe respetarse o el wordmark se deforma. -->
    <img src="/assets/konsta-logo.png" alt="Konsta" width="64" height="30" />
  </a>

  <nav class="header__nav" aria-label="Principal">
    {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    <SocialLinks size={17} />
    <a href="#aliados" class="header__cta">Ser aliado</a>
  </nav>

  <button
    class="header__burger"
    type="button"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="menu-movil"
    data-menu-open
  >
    <span></span>
    <span></span>
  </button>
</header>

<div class="menu" id="menu-movil" hidden data-menu>
  <div class="menu__bar">
    <a href="#hero" class="menu__logo" aria-label="Konsta — inicio" data-menu-link>
      <img src="/assets/konsta-logo.png" alt="Konsta" width="64" height="30" />
    </a>
    <button class="menu__close" type="button" aria-label="Cerrar menú" data-menu-close>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M5 5l14 14M19 5L5 19"></path>
      </svg>
    </button>
  </div>

  <nav class="menu__nav" aria-label="Principal (móvil)">
    {navLinks.map((l) => <a href={l.href} class="display menu__link" data-menu-link>{l.label}</a>)}
  </nav>

  <div class="menu__foot">
    <a href="#aliados" class="pill menu__cta" data-menu-link>Ser aliado</a>
    <SocialLinks size={20} gap={20} />
  </div>
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px var(--gutter);
    background: var(--header-bg);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--hairline-soft);
  }

  .header__logo,
  .menu__logo {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .header__logo img,
  .menu__logo img {
    height: 30px;
    width: auto;
    display: block;
  }

  .header__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(12px, 2vw, 28px);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .header__cta {
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    background: var(--color-blue);
    color: var(--color-white);
    transition: background 0.3s var(--ease-out);
  }

  .header__cta:hover {
    background: var(--blue-hover);
    color: var(--color-white);
  }

  /* --- botón hamburguesa ------------------------------------------- */
  .header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    cursor: pointer;
  }

  .header__burger span {
    display: block;
    width: 24px;
    height: 1.5px;
    margin-inline: auto;
    background: currentColor;
  }

  /* --- overlay ------------------------------------------------------ */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    background: var(--color-white);
    padding-bottom: max(28px, env(safe-area-inset-bottom));
    opacity: 0;
    transition: opacity 0.32s var(--ease-out);
  }

  .menu[hidden] {
    display: none;
  }

  .menu[data-open] {
    opacity: 1;
  }

  .menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px var(--gutter);
    border-bottom: 1px solid var(--hairline-soft);
  }

  .menu__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -11px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    cursor: pointer;
  }

  .menu__nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-inline: var(--gutter);
    overflow-y: auto;
  }

  .menu__link {
    padding: clamp(14px, 2.4vh, 22px) 0;
    font-size: clamp(34px, 11vw, 54px);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--hairline);
    transform: translateY(14px);
    opacity: 0;
    transition:
      opacity 0.5s var(--ease-out) var(--stagger, 0s),
      transform 0.5s var(--ease-out) var(--stagger, 0s);
  }

  .menu[data-open] .menu__link {
    opacity: 1;
    transform: none;
  }

  .menu__link:nth-child(1) {
    --stagger: 0.06s;
  }
  .menu__link:nth-child(2) {
    --stagger: 0.11s;
  }
  .menu__link:nth-child(3) {
    --stagger: 0.16s;
  }
  .menu__link:nth-child(4) {
    --stagger: 0.21s;
  }

  .menu__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 26px var(--gutter) 0;
    border-top: 1px solid var(--hairline);
  }

  .menu__cta {
    flex: 1 1 auto;
    justify-content: center;
  }

  /* El menú completo solo cabe en pantallas anchas. */
  @media (max-width: 900px) {
    .header__nav {
      display: none;
    }

    .header__burger {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu__link {
      transition: none;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (menu && openBtn && closeBtn) {
    const open = () => {
      menu.hidden = false;
      // Un frame antes de marcar el estado para que la transición arranque desde opacity 0.
      requestAnimationFrame(() => menu.setAttribute('data-open', ''));
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    };

    const close = () => {
      menu.removeAttribute('data-open');
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      const done = () => {
        menu.hidden = true;
        menu.removeEventListener('transitionend', done);
      };
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) done();
      else menu.addEventListener('transitionend', done);
      openBtn.focus();
    };

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);

    // Cada enlace navega a su ancla: cerrar para que el scroll suave sea visible.
    menu.querySelectorAll('[data-menu-link]').forEach((el) => el.addEventListener('click', close));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) close();
    });

    // Si se pasa a escritorio con el menú abierto, la nav normal vuelve a estar disponible.
    matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
      if (e.matches && !menu.hidden) close();
    });
  }
</script>
