---
import { idiomaDeUrl, t } from '../i18n/ui';

/** Indicador de scroll para las fotos a pantalla completa. */
interface Props {
  label?: string;
}

const { label = t(idiomaDeUrl(Astro.url)).comun.continuaBajando } = Astro.props;
---

<div class="cue" aria-hidden="true">
  <span class="cue__label">{label}</span>
  <span class="cue__badge">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M12 5v14m0 0l-6-6m6 6l6-6"></path>
    </svg>
  </span>
</div>

<style>
  .cue {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    bottom: clamp(14px, 2.6vh, 28px);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    pointer-events: none;
    color: var(--color-white);
  }

  .cue__label {
    font-size: clamp(10px, 0.9vw, 12px);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
    text-shadow: 0 1px 14px rgba(17, 17, 17, 0.55);
    white-space: nowrap;
  }

  .cue__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-blue);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow: 0 8px 24px rgba(17, 17, 17, 0.35);
    /* Animación propia: solo desplaza. La del punto pulsante bajaba la
       opacidad y sobre el agua azul lo dejaba invisible. */
    animation: cue-bajar 2.2s ease-in-out infinite;
  }

  @keyframes cue-bajar {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cue__badge {
      animation: none;
    }
  }
</style>
