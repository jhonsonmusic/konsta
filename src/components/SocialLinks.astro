---
import { social } from '../data/site';

interface Props {
  size?: number;
  gap?: number;
  class?: string;
}

const { size = 17, gap = 14, class: className } = Astro.props;
---

<div class:list={['social', className]} style={`--gap:${gap}px;--size:${size}px`}>
  <a href={social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
    <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"></circle>
    </svg>
  </a>
  <a href={social.tiktok} target="_blank" rel="noopener" aria-label="TikTok">
    <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true">
      <path d="M14 3h2.4c.3 2 1.6 3.4 3.6 3.6V9c-1.5 0-2.8-.5-3.8-1.3v6.6a5.3 5.3 0 1 1-5.3-5.3c.3 0 .6 0 .9.1v2.5a2.8 2.8 0 1 0 1.9 2.7V3z"></path>
    </svg>
  </a>
</div>

<style>
  .social {
    display: flex;
    align-items: center;
    gap: var(--gap);
  }

  .social a {
    display: flex;
    color: inherit;
  }
</style>
