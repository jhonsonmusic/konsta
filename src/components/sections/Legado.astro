---
import Reel from '../Reel.astro';
import { idiomaDeUrl, ruta, t as tr } from '../../i18n/ui';

const idioma = idiomaDeUrl(Astro.url);
const txt = tr(idioma);

/** Titular centrado y dos bloques con los reels cruzados. */
---

<section id="legado" class="legado section--rule">
  <h1 class="display legado__titulo" data-reveal style="--reveal-y:28px;--reveal-dur:1s">
    {txt.legado.titulo} <span class="legado__acento">{txt.legado.acento}</span>
  </h1>

  <div class="bloque">
    <div class="bloque__texto">
      <p class="legado__copy" data-reveal style="--reveal-y:24px;--reveal-delay:.08s">
        {txt.legado.parrafo1}
      </p>
      <p class="legado__copy" data-reveal style="--reveal-y:24px;--reveal-delay:.14s">
        {txt.legado.parrafo2}
      </p>
    </div>

    <div class="bloque__reel" data-parallax="0.03">
      <Reel src="/assets/coleccionlegado/reel-1.mp4" label={txt.legado.reel1Alt} />
    </div>
  </div>

  <div class="bloque bloque--invertido">
    <div class="bloque__reel" data-parallax="-0.03">
      <Reel src="/assets/coleccionlegado/reel-2.mp4" label={txt.legado.reel2Alt} />
    </div>

    <div class="bloque__texto">
      <h2 class="display legado__sub" data-reveal style="--reveal-y:22px;--reveal-dur:.8s">
        {txt.legado.sub}
      </h2>

      <div class="card" data-reveal style="--reveal-y:24px;--reveal-delay:.08s">
        <span class="card__label">{txt.legado.card1Label}</span>
        <p class="card__body">
          {txt.legado.card1Body}
        </p>
      </div>

      <div class="card" data-reveal style="--reveal-y:24px;--reveal-delay:.16s">
        <span class="card__label">{txt.legado.card2Label}</span>
        <p class="card__body">
          {txt.legado.card2Body}
        </p>
      </div>

      <p class="card__body" data-reveal style="--reveal-y:24px;--reveal-delay:.22s">
        {txt.legado.cierre}
      </p>

      <a
        href={ruta(idioma, '/ser-aliado')}
        class="pill pill--lg legado__cta"
        data-reveal
        style="--reveal-y:24px;--reveal-delay:.28s"
      >
        {txt.legado.cta}
      </a>
    </div>
  </div>
</section>

<style>
  .legado {
    padding: clamp(60px, 10vh, 130px) var(--gutter);
  }

  /* Misma escala que los titulares de Modo Tiburón, sin tope de ancho para
     que la frase entre en un solo renglón. */
  .legado__titulo {
    font-size: clamp(40px, 4.8vw, 78px);
    line-height: 0.93;
    margin: 0 auto clamp(34px, 6vh, 64px);
    text-align: center;
    text-wrap: balance;
  }

  .legado__acento {
    color: var(--color-blue);
  }

  /* Texto ancho, reel angosto; en el segundo bloque se invierten. */
  .bloque {
    display: grid;
    grid-template-columns: minmax(min(100%, 320px), 1.6fr) minmax(min(100%, 240px), 0.9fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
  }

  .bloque--invertido {
    margin-top: clamp(60px, 10vh, 130px);
    grid-template-columns: minmax(min(100%, 240px), 0.9fr) minmax(min(100%, 320px), 1.6fr);
    align-items: start;
  }

  .bloque__texto {
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 3vh, 28px);
  }

  .legado__copy {
    font-size: clamp(22px, 1.9vw, 27px);
    line-height: 1.55;
    font-weight: 300;
    color: var(--color-body);
    margin: 0;
    text-wrap: pretty;
  }

  .legado__sub {
    font-size: clamp(40px, 4.8vw, 78px);
    line-height: 0.93;
    letter-spacing: 0.02em;
    color: var(--color-blue);
    margin: 0;
  }

  .legado__cta {
    align-self: flex-start;
  }

  /* En móvil el reel siempre queda debajo del texto. */
  @media (max-width: 760px) {
    .bloque,
    .bloque--invertido {
      grid-template-columns: 1fr;
    }

    .bloque--invertido .bloque__reel {
      order: 2;
    }
  }
</style>
