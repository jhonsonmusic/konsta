---
import { idiomaDeUrl, t as tr } from '../../i18n/ui';

/** El video del manifiesto lleva la voz de Konsta: se reproduce con el clic. */
const txt = tr(idiomaDeUrl(Astro.url));
---

<section id="manifiesto-compromiso" class="compromiso">
  <h2 class="display compromiso__titulo" data-reveal style="--reveal-y:28px;--reveal-dur:1s">
    {txt.ecosistema.manifiestoTitulo} <span class="compromiso__acento">{txt.ecosistema.manifiestoAcento}</span>
  </h2>

  <blockquote class="compromiso__cita" data-reveal style="--reveal-y:26px;--reveal-delay:.1s">
    {txt.ecosistema.citaInicio} <strong>{txt.ecosistema.citaFuerte1}</strong>{txt.ecosistema.citaMedio}
    <strong>{txt.ecosistema.citaFuerte2}</strong>{txt.ecosistema.citaFin}
  </blockquote>

  <span class="compromiso__firma" data-reveal style="--reveal-y:20px;--reveal-delay:.16s">
    {txt.ecosistema.firma}
  </span>

  <div class="compromiso__video" data-reveal style="--reveal-y:24px;--reveal-delay:.2s">
    <!-- Lleva voz: arranca con el clic, no en automático. -->
    <video
      id="konsta-manifiesto-video"
      src="/assets/manifiesto.mp4"
      poster="/assets/manifiesto-poster.jpg"
      controls
      playsinline
      preload="none"
      aria-label={txt.ecosistema.videoAlt}></video>
  </div>
</section>

<style>
  .compromiso {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: var(--color-white);
    padding: clamp(30px, 5vh, 64px) var(--gutter) clamp(70px, 11vh, 140px);
  }

  .compromiso__titulo {
    font-size: clamp(40px, 4.8vw, 78px);
    line-height: 0.93;
    margin: 0 0 clamp(24px, 4vh, 40px);
    text-wrap: balance;
  }

  .compromiso__acento {
    color: var(--color-blue);
  }

  .compromiso__cita {
    /* Mismo cuerpo y ancho que la descripción de la apertura. */
    max-width: min(86vw, 980px);
    margin: 0 0 18px;
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.55;
    font-weight: 300;
    color: var(--color-body);
    text-wrap: pretty;
  }

  .compromiso__cita strong {
    font-weight: 500;
    color: var(--color-blue);
  }

  .compromiso__firma {
    font-size: var(--size-copy);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-muted);
  }

  .compromiso__video {
    width: min(100%, 900px);
    margin-top: clamp(34px, 6vh, 64px);
  }

  .compromiso__video video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    display: block;
    border-radius: 28px;
    background: rgba(17, 17, 17, 0.06);
  }
</style>
