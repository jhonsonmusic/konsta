---
import Media from '../Media.astro';
import { idiomaDeUrl, t as tr } from '../../i18n/ui';

const txt = tr(idiomaDeUrl(Astro.url));
---

<section id="familia" class="familia two-col">
  <div data-parallax="-0.05">
    <Media
      id="konsta-familia"
      src="/assets/konsta-familia.jpg"
      alt={txt.familia.fotoAlt}
      caption={txt.familia.fotoAlt}
      aspect="5 / 4"
      radius="28px 28px 28px 160px"
      mono={false}
      clipFrom="inset(0 100% 0 0)"
    />
  </div>

  <div>
    <h2 class="display familia__title" data-reveal style="--reveal-delay:.06s">
      {txt.familia.titulo1} <span class="familia__accent">{txt.familia.acento1}</span> {txt.familia.titulo2}
      <span class="familia__accent">{txt.familia.acento2}</span><br />{txt.familia.titulo3}
    </h2>
    <p class="body-copy familia__p" data-reveal style="--reveal-delay:.14s">
      {txt.familia.parrafo1}
    </p>
    <p class="body-copy familia__p" data-reveal style="--reveal-delay:.2s">
      {txt.familia.parrafo2}
    </p>
  </div>
</section>

<style>
  .familia {
    align-items: center;
    padding: clamp(40px, 7vh, 90px) var(--gutter) clamp(70px, 11vh, 140px);
  }


  .familia__title {
    font-size: clamp(40px, 4.8vw, 78px);
    line-height: 0.93;
    margin: 0 0 26px;
  }

  .familia__accent {
    color: var(--color-blue);
  }

  .familia__p {
    /* Mismo tratamiento que los párrafos de las demás secciones. */
    max-width: 52ch;
    text-align: justify;
    hyphens: auto;
  }

  /* En columna estrecha el justificado parte demasiadas palabras. */
  @media (max-width: 760px) {
    .familia__p {
      text-align: left;
      hyphens: manual;
    }
  }

  .familia__p + .familia__p {
    margin-top: 20px;
  }
</style>
