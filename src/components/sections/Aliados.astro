---
import Media from '../Media.astro';
import PlayBadge from '../PlayBadge.astro';
import { links } from '../../data/site';

/**
 * Dos bloques con los reels cruzados: en el primero el video va a la derecha
 * y en el segundo a la izquierda.
 * TODO cliente: faltan los dos archivos de los reels (formato vertical 9:16).
 */
---

<section id="aliados" class="aliados section section--rule">
  <div class="bloque">
    <div class="bloque__texto">
      <h1 class="display aliados__titulo" data-reveal style="--reveal-y:28px;--reveal-dur:1s">
        SER PARTE DE KONSTA ES <span class="aliados__acento">REDEFINIR LOS LÍMITES</span>
      </h1>
      <p class="aliados__copy" data-reveal style="--reveal-y:24px;--reveal-delay:.08s">
        Al asociarte con este proyecto, tu marca no aparece únicamente en un uniforme de alta
        competición; entra a formar parte de un ecosistema donde el liderazgo, la gestión y el
        impacto social se unen. Konsta es el embajador de una disciplina en pleno crecimiento, un
        gestor que moviliza, inspira y lidera a la próxima generación de campeones mundiales
        colombianos.
      </p>
      <span class="display aliados__firma" data-reveal style="--reveal-y:20px;--reveal-delay:.14s">
        DETERMINACIÓN IMPARABLE.
      </span>
    </div>

    <div class="bloque__reel" data-parallax="0.03">
      <Media
        id="konsta-reel-1"
        caption="Reel 1 — pendiente de entrega"
        aspect="9 / 16"
        radius="26px"
      >
        <PlayBadge size={66} padding={22} />
      </Media>
    </div>
  </div>

  <div class="bloque bloque--invertido">
    <div class="bloque__reel" data-parallax="-0.03">
      <Media
        id="konsta-reel-2"
        caption="Reel 2 — pendiente de entrega"
        aspect="9 / 16"
        radius="26px"
      >
        <PlayBadge size={66} padding={22} />
      </Media>
    </div>

    <div class="bloque__texto">
      <h2 class="display aliados__pregunta" data-reveal style="--reveal-y:24px">
        ¿TIENES LA VISIÓN CORPORATIVA PARA CONSTRUIR UN LEGADO QUE TRASCIENDA EL PODIO?
      </h2>

      <a
        href={links.brochure}
        class="action action--ink"
        data-reveal
        style="--reveal-y:24px;--reveal-delay:.1s"
      >
        <span class="action__text">
          <span class="label">Descargar brochure técnico de patrocinio</span>
          <span class="action__sub">Dossier corporativo y ROI para marcas</span>
        </span>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M12 4v12m0 0l-5-5m5 5l5-5M4 20h16"></path>
        </svg>
      </a>

      <a
        href={links.contacto}
        class="action action--blue"
        data-reveal
        style="--reveal-y:24px;--reveal-delay:.16s"
      >
        <span class="action__text">
          <span class="label">Contactar al equipo de gestión</span>
          <span class="action__sub action__sub--blue">Canal directo gestionado por CONEX1ON PSH</span>
        </span>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M5 12h13m0 0l-5-5m5 5l-5 5"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .aliados {
    padding: clamp(50px, 8vh, 110px) var(--gutter) clamp(84px, 10vh, 110px);
  }

  /* Texto ancho y reel angosto: el vertical no debe comerse la columna. */
  .bloque {
    display: grid;
    grid-template-columns: minmax(min(100%, 320px), 1.6fr) minmax(min(100%, 240px), 0.9fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
  }

  .bloque--invertido {
    margin-top: clamp(60px, 10vh, 130px);
    grid-template-columns: minmax(min(100%, 240px), 0.9fr) minmax(min(100%, 320px), 1.6fr);
  }

  .bloque__texto {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .bloque__reel {
    width: min(100%, 400px);
    margin-inline: auto;
  }

  .aliados__titulo {
    font-size: clamp(40px, 4.8vw, 78px);
    line-height: 0.9;
    margin: 0;
    text-wrap: balance;
  }

  .aliados__acento {
    color: var(--color-blue);
  }

  .aliados__copy {
    font-size: clamp(22px, 1.9vw, 27px);
    line-height: 1.55;
    font-weight: 300;
    color: var(--color-body);
    margin: 0;
    text-wrap: pretty;
  }

  .aliados__firma {
    display: block;
    font-size: clamp(24px, 2.4vw, 40px);
    letter-spacing: 0.04em;
  }

  .aliados__pregunta {
    font-size: clamp(30px, 3.3vw, 56px);
    line-height: 1.04;
    letter-spacing: 0.015em;
    margin: 0 0 8px;
    color: var(--color-blue);
    text-wrap: balance;
  }

  /* En móvil el reel siempre va debajo del texto, en los dos bloques. */
  @media (max-width: 760px) {
    .bloque,
    .bloque--invertido {
      grid-template-columns: 1fr;
    }

    .bloque--invertido .bloque__reel {
      order: 2;
    }
  }

  .action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 22px 26px;
    border-radius: var(--radius-action);
    color: var(--color-white);
    transition:
      transform 0.3s var(--ease-out),
      filter 0.3s var(--ease-out);
  }

  .action:hover {
    color: var(--color-white);
    transform: translateY(-2px);
    filter: brightness(1.12);
  }

  .action--ink {
    background: var(--color-ink);
  }

  .action--blue {
    background: var(--color-blue);
  }

  .action__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .action__sub {
    font-size: var(--size-copy);
    font-weight: 300;
    color: var(--on-blue-62);
  }

  .action__sub--blue {
    color: var(--on-blue-70);
  }
</style>
