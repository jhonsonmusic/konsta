---
import { enlaceWhatsapp, links } from '../../data/site';
import { idiomaDeUrl, t as tr } from '../../i18n/ui';

const txt = tr(idiomaDeUrl(Astro.url));

/** Dos bloques con las fotos cruzadas y, al final, el formulario de contacto. */
---

<section id="aliados" class="aliados section section--rule">
  <div class="bloque">
    <div class="bloque__texto">
      <h1 class="display aliados__titulo" data-reveal style="--reveal-y:28px;--reveal-dur:1s">
        {txt.aliados.titulo} <span class="aliados__acento">{txt.aliados.acento}</span>
      </h1>
      <p class="aliados__copy" data-reveal style="--reveal-y:24px;--reveal-delay:.08s">
        {txt.aliados.copy}
      </p>
      <span class="display aliados__firma" data-reveal style="--reveal-y:20px;--reveal-delay:.14s">
        {txt.aliados.firma}
      </span>
    </div>

    <figure class="bloque__foto" data-parallax="0.03">
      <img
        src="/assets/seraliado/1.jpg"
        alt={txt.aliados.foto1Alt}
        width="900"
        height="1200"
        loading="lazy"
      />
    </figure>
  </div>

  <div class="bloque bloque--invertido">
    <figure class="bloque__foto" data-parallax="-0.03">
      <img
        src="/assets/seraliado/2.jpg"
        alt={txt.aliados.foto2Alt}
        width="900"
        height="1200"
        loading="lazy"
      />
    </figure>

    <div class="bloque__texto">
      <h2 class="display aliados__pregunta" data-reveal style="--reveal-y:24px">
        {txt.aliados.pregunta}
      </h2>

      <a
        href={links.brochure}
        class="action action--ink"
        data-reveal
        style="--reveal-y:24px;--reveal-delay:.1s"
      >
        <span class="action__text">
          <span class="label">{txt.aliados.brochureLabel}</span>
          <span class="action__sub">{txt.aliados.brochureSub}</span>
        </span>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M12 4v12m0 0l-5-5m5 5l5-5M4 20h16"></path>
        </svg>
      </a>

      <a
        href={enlaceWhatsapp(txt.comun.whatsappMensaje)}
        target="_blank"
        rel="noopener"
        class="action action--blue"
        data-reveal
        style="--reveal-y:24px;--reveal-delay:.16s"
      >
        <span class="action__text">
          <span class="label">{txt.aliados.contactoLabel}</span>
          <span class="action__sub action__sub--blue">{txt.aliados.contactoSub}</span>
        </span>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M5 12h13m0 0l-5-5m5 5l-5 5"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .aliados {
    padding: clamp(50px, 8vh, 110px) var(--gutter) clamp(84px, 10vh, 110px);
  }

  /* Texto ancho y reel angosto: el vertical no debe comerse la columna. */
  .bloque {
    display: grid;
    grid-template-columns: minmax(min(100%, 320px), 1.6fr) minmax(min(100%, 240px), 0.9fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
  }

  .bloque--invertido {
    margin-top: clamp(60px, 10vh, 130px);
    grid-template-columns: minmax(min(100%, 240px), 0.9fr) minmax(min(100%, 320px), 1.6fr);
  }

  .bloque__texto {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .bloque__foto {
    width: min(100%, 400px);
    margin: 0 auto;
  }

  .bloque__foto img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
    border-radius: var(--radius-image);
  }

  .aliados__titulo {
    font-size: clamp(40px, 4.8vw, 78px);
    line-height: 0.9;
    margin: 0;
    text-wrap: balance;
  }

  .aliados__acento {
    color: var(--color-blue);
  }

  .aliados__copy {
    font-size: clamp(22px, 1.9vw, 27px);
    line-height: 1.55;
    font-weight: 300;
    color: var(--color-body);
    margin: 0;
    text-wrap: pretty;
  }

  .aliados__firma {
    display: block;
    font-size: clamp(24px, 2.4vw, 40px);
    letter-spacing: 0.04em;
  }

  .aliados__pregunta {
    font-size: clamp(30px, 3.3vw, 56px);
    line-height: 1.04;
    letter-spacing: 0.015em;
    margin: 0 0 8px;
    color: var(--color-blue);
    text-wrap: balance;
  }

  /* En móvil el reel siempre va debajo del texto, en los dos bloques. */
  @media (max-width: 760px) {
    .bloque,
    .bloque--invertido {
      grid-template-columns: 1fr;
    }

    .bloque--invertido .bloque__foto {
      order: 2;
    }
  }

  .action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 22px 26px;
    border-radius: var(--radius-action);
    color: var(--color-white);
    transition:
      transform 0.3s var(--ease-out),
      filter 0.3s var(--ease-out);
  }

  .action:hover {
    color: var(--color-white);
    transform: translateY(-2px);
    filter: brightness(1.12);
  }

  .action--ink {
    background: var(--color-ink);
  }

  .action--blue {
    background: var(--color-blue);
  }

  .action__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .action__sub {
    font-size: var(--size-copy);
    font-weight: 300;
    color: var(--on-blue-62);
  }

  .action__sub--blue {
    color: var(--on-blue-70);
  }
</style>
