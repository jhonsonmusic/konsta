---
import ScrollCue from '../ScrollCue.astro';
import { idiomaDeUrl, ruta, t } from '../../i18n/ui';

const idioma = idiomaDeUrl(Astro.url);
const txt = t(idioma);

/**
 * Apertura en dos tiempos:
 * 1. La foto ocupa la pantalla completa al entrar.
 * 2. Al scrollear, la foto queda fija (sticky) y el panel de copy sube por
 *    encima hasta taparla; el texto entra centrado y da paso al resto.
 */
---

<div class="hero">
  <div class="hero__visual">
    <img
      src="/assets/konsta-hero.jpg"
      alt={txt.hero.fotoAlt}
      width="1920"
      height="1080"
      fetchpriority="high"
    />
    <div class="hero__badge">
      <span class="hero__badge-dot"></span>{txt.hero.badge}
    </div>
    <ScrollCue />
  </div>

  <section id="hero" class="hero__copy">
    <div class="hero__eyebrow" data-reveal style="--reveal-y:24px;--reveal-dur:.9s">
      <span class="hero__rule"></span>
      <span>{txt.hero.eyebrow}</span>
      <span class="hero__rule"></span>
    </div>
    <h1 class="display hero__title" data-reveal style="--reveal-y:30px;--reveal-dur:1s;--reveal-delay:.08s">
      {txt.hero.titulo1} <span class="hero__accent">{txt.hero.acento1}</span><br />
      {txt.hero.titulo2} <span class="hero__accent">{txt.hero.acento2}</span>
    </h1>
    <p class="hero__lead" data-reveal style="--reveal-y:30px;--reveal-dur:1s;--reveal-delay:.16s">
      {txt.hero.lead}
    </p>
    <div class="hero__ctas" data-reveal style="--reveal-y:30px;--reveal-dur:1s;--reveal-delay:.24s">
      <a href={ruta(idioma, '/modo-tiburon')} class="pill">{txt.hero.cta}</a>
    </div>
  </section>
</div>

<div class="tagline">
  <span class="tagline__rule"></span>
  <span>{txt.hero.valores[0]}</span><span>·</span><span>{txt.hero.valores[1]}</span><span>·</span>
  <span>{txt.hero.valores[2]}</span>
  <span class="tagline__rule"></span>
</div>

<style>
  .hero {
    position: relative;
    /* El header sticky vive encima; la foto arranca detrás de él. */
    margin-top: calc(-1 * var(--header-h, 71px));
  }

  .hero__visual {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .hero__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero__badge {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(28px, 6vh, 56px);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-white);
    border: 1px solid var(--hairline);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* Abajo no cabe junto al indicador "continúa bajando": sube al arranque. */
  @media (max-width: 700px) {
    .hero__badge {
      bottom: auto;
      top: calc(var(--header-h, 71px) + 16px);
    }
  }

  .hero__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-blue);
    animation: km-drip 2.4s ease-in-out infinite;
  }



  /* El panel de copy sube por encima de la foto: fondo sólido + z-index. */
  .hero__copy {
    position: relative;
    z-index: 1;
    background: var(--color-white);
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(70px, 12vh, 130px) var(--gutter) clamp(60px, 10vh, 120px);
    box-sizing: border-box;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: clamp(20px, 4vh, 40px);
    font-size: var(--size-copy);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .hero__rule {
    width: clamp(28px, 5vw, 46px);
    height: 1px;
    background: var(--color-blue);
    opacity: 0.8;
  }

  /* Con el eyebrow al tamaño del cuerpo, las rayitas lo parten en móvil. */
  @media (max-width: 520px) {
    .hero__rule {
      display: none;
    }
  }

  .hero__title {
    /* Misma escala que el titular de Modo Tiburón. */
    font-size: clamp(40px, 4.8vw, 78px);
    line-height: 0.93;
    letter-spacing: 0.005em;
    margin: 0 0 clamp(22px, 3.4vh, 38px);
    text-wrap: balance;
  }

  /* Titular uniforme en Bebas; el único acento es el azul de marca. */
  .hero__accent {
    color: var(--color-blue);
  }

  .hero__lead {
    /* Tope: el ancho del renglón más largo del titular, ni un píxel más.
       Escala con el vw igual que él y se detiene cuando topa en 78px. */
    max-width: min(42vw, 685px);
    /* Mismo cuerpo que la descripción de Modo Tiburón, con el interlineado
       un punto más cerrado. */
    font-size: clamp(22px, 1.9vw, 27px);
    line-height: 1.4;
    font-weight: 300;
    color: var(--color-body);
    margin: 0 0 clamp(28px, 4vh, 44px);
    text-wrap: pretty;
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 26px;
    flex-wrap: wrap;
  }

  .tagline {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(8px, 3vw, 40px);
    padding: 0 var(--gutter) clamp(20px, 3vh, 36px);
    /* Mismo cuerpo que la descripción del hero, en azul de marca. */
    font-size: clamp(22px, 1.9vw, 27px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-blue);
  }

  .tagline__rule {
    flex: 1 1 24px;
    min-width: 0;
    height: 1px;
    background: var(--hairline-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__badge-dot {
      animation: none;
    }
  }
</style>
