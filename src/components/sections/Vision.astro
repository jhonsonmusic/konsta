---
import Media from '../Media.astro';

/** TODO cliente: confirmar los hitos 2026–2028 (borrador según el brief). */
const milestones = [
  { year: '2026', text: 'Defensa del Ranking #1 departamental.', active: true },
  { year: '2027', text: 'Consolidación nacional y récords de la modalidad.', active: false },
  { year: '2028', text: 'Circuito internacional y clasificación.', active: false },
  {
    year: '2029',
    text: 'The World Games · Karlsruhe, Alemania · 19–29 de julio.',
    active: true,
    highlight: true,
  },
];
---

<section id="vision" class="vision section section--rule">
  <div class="two-col vision__grid">
    <div data-parallax="-0.05">
      <Media
        id="konsta-vision"
        caption="Konsta de espaldas mirando el horizonte"
        aspect="4 / 5"
        radius="180px 26px 26px 26px"
      />
    </div>
    <div>
      <span class="eyebrow vision__eyebrow" data-reveal style="--reveal-y:20px;--reveal-dur:.8s">
        08 — El horizonte
      </span>
      <h2 class="display vision__title" data-reveal style="--reveal-delay:.06s">
        EL HORIZONTE:<br /><span class="vision__accent">THE WORLD GAMES 2029</span>
      </h2>
      <p class="body-copy vision__p" data-reveal style="--reveal-delay:.12s">
        El gran objetivo está marcado en el calendario: The World Games 2029, del 19 al 29 de julio
        de 2029 en Karlsruhe, Alemania. Pero mi visión va mucho más allá de competir; lo que más
        anhelo es llevar la tricolor a lo más alto, regalarle una alegría inmensa a mi Colombia y
        demostrarle al planeta entero el nivel y el talento extraordinario que hay en nuestro país.
      </p>
      <p class="body-copy vision__p" data-reveal style="--reveal-delay:.18s">
        Para llegar con absoluta solidez a este escenario mundial, cada jornada se enfoca en superar
        mis propios límites, perfeccionar la técnica y ejecutar una estrategia milimétrica que parte
        desde la defensa del Ranking #1 departamental hasta la consolidación internacional. No espero
        que los resultados lleguen por casualidad; los construyo sesión tras sesión, elevando el
        estándar y rompiendo marcas.
      </p>
      <p class="body-copy" data-reveal style="--reveal-delay:.24s">
        El alto rendimiento es un compromiso absoluto con el legado. Estamos construyendo una
        cultura, una disciplina y un ejemplo imborrable de integridad deportiva a través del trabajo
        duro y la superación constante, listos para representar con orgullo a Colombia ante el mundo.
      </p>
    </div>
  </div>

  <ol class="timeline" data-reveal style="--reveal-y:24px;--reveal-dur:1s">
    {
      milestones.map((m) => (
        <li>
          <span class:list={['timeline__dot', { 'timeline__dot--on': m.active }]} />
          <span class:list={['display', 'timeline__year', { 'timeline__year--hl': m.highlight }]}>
            {m.year}
          </span>
          <span class="timeline__text">{m.text}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .vision {
    padding-block: clamp(60px, 10vh, 130px);
  }

  .vision__grid {
    align-items: center;
  }

  .vision__eyebrow {
    margin-bottom: 18px;
  }

  .vision__title {
    font-size: clamp(40px, 5.2vw, 92px);
    line-height: 0.9;
    margin: 0 0 26px;
    text-wrap: balance;
  }

  .vision__accent {
    color: var(--color-blue);
  }

  .vision__p {
    margin-bottom: 18px;
  }

  .timeline {
    list-style: none;
    margin: clamp(46px, 8vh, 96px) 0 0;
    padding: 30px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    gap: clamp(18px, 2.4vw, 34px);
    border-top: 1px solid var(--hairline-strong);
  }

  .timeline__dot {
    display: block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--dot-muted);
    margin: -34px 0 20px;
  }

  .timeline__dot--on {
    background: var(--color-blue);
  }

  .timeline__year {
    display: block;
    font-size: 34px;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .timeline__year--hl {
    color: var(--color-blue);
  }

  .timeline__text {
    display: block;
    font-size: 13px;
    line-height: 1.6;
    font-weight: 300;
    color: var(--color-body);
    margin-top: 8px;
  }
</style>
