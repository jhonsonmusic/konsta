---
import Media from '../Media.astro';
import SocialLinks from '../SocialLinks.astro';
import { idiomaDeUrl, ruta, t } from '../../i18n/ui';

const idioma = idiomaDeUrl(Astro.url);
const txt = t(idioma);
---

<section id="tiburon" class="tiburon">
  <div>
    <p class="display tiburon__lead" data-reveal style="--reveal-y:28px;--reveal-dur:1s;--reveal-delay:.08s">
      {txt.tiburonInicio.lead}
      <span class="tiburon__strong">{txt.tiburonInicio.leadFuerte}</span>
    </p>
    <p class="display tiburon__climax" data-reveal style="--reveal-y:34px;--reveal-dur:1.1s;--reveal-delay:.18s">
      {txt.tiburonInicio.climax1}<br />{txt.tiburonInicio.climax2}
    </p>
    <div class="tiburon__ctas" data-reveal style="--reveal-y:26px;--reveal-dur:1s;--reveal-delay:.26s">
      <a href={ruta(idioma, '/ser-aliado')} class="pill pill--lg pill--invert">{txt.tiburonInicio.cta}</a>
      <div class="tiburon__social">
        <span class="tiburon__social-label">{txt.tiburonInicio.redes}</span>
        <SocialLinks size={18} gap={16} />
      </div>
    </div>
  </div>

  <div data-parallax="-0.09">
    <Media
      id="konsta-tiburon"
      src="/assets/konsta-tiburon.jpg"
      alt={txt.tiburonInicio.fotoAlt}
      caption={txt.tiburonInicio.fotoAlt}
      aspect="3 / 4"
      radius="22px 22px 180px 22px"
      mono={false}
      clipFrom="inset(100% 0 0 0)"
      clipDelay=".1s"
      clipDuration="1.3s"
    />
  </div>
</section>

<style>
  .tiburon {
    margin: 0 clamp(10px, 1.6vw, 22px);
    border-radius: var(--radius-panel);
    background: var(--color-blue);
    color: var(--color-white);
    padding: clamp(48px, 8vh, 110px) clamp(24px, 4vw, 72px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1.4fr));
    gap: clamp(28px, 4vw, 64px);
    align-items: end;
  }


  .tiburon__lead {
    font-size: clamp(34px, 4.3vw, 74px);
    line-height: 1.02;
    letter-spacing: 0.015em;
    margin: 0 0 clamp(20px, 3vh, 34px);
    color: var(--on-blue-58);
    text-wrap: balance;
  }

  .tiburon__strong {
    color: var(--color-white);
  }

  .tiburon__climax {
    font-size: clamp(54px, 8.6vw, 158px);
    line-height: 0.86;
    letter-spacing: 0.01em;
  }

  .tiburon__ctas {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
    margin-top: clamp(28px, 4vh, 48px);
  }

  .tiburon__social {
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--color-white);
  }

  .tiburon__social-label {
    font-size: var(--size-copy);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    opacity: 0.72;
  }
</style>
