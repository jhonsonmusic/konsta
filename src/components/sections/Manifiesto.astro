---
import Media from '../Media.astro';

/** Antes: cita del manifiesto + bloque de video. Ahora: tres fotos en una fila. */
const fotos = [
  {
    id: 'konsta-manifiesto-1',
    alt: 'Grupo de deportistas de monoaleta reunido en el borde de la piscina antes de entrenar',
  },
  {
    id: 'konsta-manifiesto-2',
    alt: 'Dos deportistas ajustando la monoaleta al borde de la piscina',
  },
  {
    id: 'konsta-manifiesto-3',
    alt: 'Dos deportistas guardando las monoaletas y el equipo después del entrenamiento',
  },
];
---

<section id="manifiesto" class="manifiesto section section--rule">
  <div class="manifiesto__fila">
    {
      fotos.map((foto, i) => (
        <Media
          id={foto.id}
          src={`/assets/${foto.id}.jpg`}
          alt={foto.alt}
          caption={foto.alt}
          aspect="3 / 4"
          mono={false}
          clipDelay={`${i * 0.1}s`}
          clipDuration="1.1s"
        />
      ))
    }
  </div>
</section>

<style>
  .manifiesto {
    /* Fondo sólido: esta capa pasa por encima de la anterior al scrollear. */
    background: var(--color-white);
    padding-block: clamp(60px, 10vh, 130px);
  }

  /* Las tres, siempre en una sola fila. */
  .manifiesto__fila {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(6px, 1.4vw, 24px);
  }
</style>
