---
import Media from '../Media.astro';
import { idiomaDeUrl, t as tr } from '../../i18n/ui';

const txt = tr(idiomaDeUrl(Astro.url));

/** Antes: cita del manifiesto + bloque de video. Ahora: tres fotos en una fila. */
const fotos = ['konsta-manifiesto-1', 'konsta-manifiesto-2', 'konsta-manifiesto-3'];
---

<section id="manifiesto" class="manifiesto section section--rule">
  <div class="manifiesto__fila">
    {
      fotos.map((id, i) => (
        <Media
          id={id}
          src={`/assets/${id}.jpg`}
          alt={txt.ecosistema.fotos[i]}
          caption={txt.ecosistema.fotos[i]}
          aspect="3 / 4"
          mono={false}
          clipDelay={`${i * 0.1}s`}
          clipDuration="1.1s"
        />
      ))
    }
  </div>
</section>

<style>
  .manifiesto {
    /* Fondo sólido: esta capa pasa por encima de la anterior al scrollear. */
    background: var(--color-white);
    padding-top: clamp(30px, 5vh, 64px);
    padding-bottom: clamp(60px, 10vh, 130px);
  }

  /* Las tres, siempre en una sola fila. */
  .manifiesto__fila {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(6px, 1.4vw, 24px);
  }
</style>
