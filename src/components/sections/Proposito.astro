---
import { idiomaDeUrl, t as tr } from '../../i18n/ui';

/** Apertura de Ecosistema: titular y palabras de Konsta, centrados como el hero. */
const txt = tr(idiomaDeUrl(Astro.url));
---

<section id="proyecto" class="proposito">
  <h1 class="display proposito__titulo" data-reveal style="--reveal-y:28px;--reveal-dur:1s">
    {txt.ecosistema.titulo1} <span class="proposito__acento">{txt.ecosistema.acento1}</span>
    {txt.ecosistema.titulo2} <span class="proposito__acento">{txt.ecosistema.acento2}</span>
  </h1>

  <div class="proposito__copy">
    <p data-reveal style="--reveal-y:26px;--reveal-delay:.1s">
      {txt.ecosistema.parrafo1}
    </p>
    <p data-reveal style="--reveal-y:26px;--reveal-delay:.16s">
      {txt.ecosistema.parrafo2}
    </p>
    <p data-reveal style="--reveal-y:26px;--reveal-delay:.22s">
      {txt.ecosistema.parrafo3}
    </p>
  </div>

  <p class="display proposito__cierre" data-reveal style="--reveal-y:26px;--reveal-delay:.28s">
    {txt.ecosistema.cierre1} <span class="proposito__acento">{txt.ecosistema.cierreAcento1}</span
    >{txt.ecosistema.cierre2} <span class="proposito__acento">{txt.ecosistema.cierreAcento2}</span>.
  </p>
</section>

<style>
  .proposito {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--color-white);
    padding: clamp(40px, 7vh, 90px) var(--gutter) clamp(40px, 7vh, 90px);
    box-sizing: border-box;
  }

  /* En móvil el bloque debe caber en una pantalla: la capa que lo contiene
     queda fija y recorta lo que sobresalga. */
  @media (max-width: 700px) {
    .proposito {
      padding-block: clamp(24px, 4vh, 48px);
    }

    .proposito__copy {
      gap: 12px;
    }
  }

  /* Misma escala del titular del hero. */
  .proposito__titulo {
    font-size: clamp(28px, 6.6vw, 88px);
    line-height: 0.9;
    letter-spacing: 0.005em;
    margin: 0 0 clamp(22px, 3.4vh, 38px);
    text-wrap: balance;
  }

  .proposito__acento {
    color: var(--color-blue);
  }

  .proposito__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: min(86vw, 980px);
  }

  .proposito__copy p {
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.55;
    font-weight: 300;
    color: var(--color-body);
    margin: 0;
    text-wrap: pretty;
  }

  /* Misma escala que el titular de Modo Tiburón. Fuera del bloque de copy
     para que ese ancho no lo parta en dos renglones. */
  .proposito__cierre {
    font-size: clamp(40px, 4.8vw, 78px);
    line-height: 0.93;
    letter-spacing: 0.015em;
    color: var(--color-ink);
    font-weight: 400;
    margin: clamp(20px, 3.5vh, 34px) 0 0;
    text-wrap: balance;
  }

  /* A 40px la frase ocupa tres renglones y el bloque deja de caber en una
     pantalla, que es lo que necesita la capa anclada. */
  @media (max-width: 700px) {
    .proposito__cierre {
      font-size: clamp(22px, 6.4vw, 32px);
      margin-top: 18px;
    }
  }
</style>
