---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollTop from '../components/ScrollTop.astro';
import BotonWhatsapp from '../components/BotonWhatsapp.astro';
import { idiomaDeUrl, rutaAlterna } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const idioma = idiomaDeUrl(Astro.url);
const canonical = new URL(Astro.url.pathname, Astro.site);
const alterna = new URL(rutaAlterna(idioma, Astro.url), Astro.site);
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/konsta-logo.png" />

    <!-- Cada página declara su equivalente en el otro idioma. -->
    <link rel="alternate" hreflang={idioma} href={canonical} />
    <link rel="alternate" hreflang={idioma === 'es' ? 'en' : 'es'} href={alterna} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={idioma === 'es' ? 'es_CO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- TODO producción: auto-hospedar Bebas Neue e Inter. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ScrollTop />
    <BotonWhatsapp />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
